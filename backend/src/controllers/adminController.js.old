const { prisma } = require('../../database/init');
const { createAuditLog } = require('../utils/auditLog');

const getUsers = (req, res) => {
  const db = getDatabase();
  const page = parseInt(req.query.page) || 1;
  const limit = parseInt(req.query.limit) || 10;
  const offset = (page - 1) * limit;

  db.all(
    `SELECT id, email, role, is_active, is_locked, last_login, created_at 
     FROM users 
     ORDER BY created_at DESC 
     LIMIT ? OFFSET ?`,
    [limit, offset],
    (err, users) => {
      if (err) {
        return res.status(500).json({ success: false, message: 'Database error' });
      }

      db.get('SELECT COUNT(*) as total FROM users', (err, count) => {
        if (err) {
          return res.status(500).json({ success: false, message: 'Database error' });
        }

        res.json({
          success: true,
          data: {
            users,
            pagination: {
              page,
              limit,
              total: count.total,
              totalPages: Math.ceil(count.total / limit)
            }
          }
        });
      });
    }
  );
};

const getUserById = (req, res) => {
  const db = getDatabase();
  const { id } = req.params;

  db.get(
    'SELECT id, email, role, is_active, is_locked, failed_login_attempts, last_login, created_at, updated_at FROM users WHERE id = ?',
    [id],
    (err, user) => {
      if (err) {
        return res.status(500).json({ success: false, message: 'Database error' });
      }

      if (!user) {
        return res.status(404).json({ success: false, message: 'User not found' });
      }

      res.json({
        success: true,
        data: user
      });
    }
  );
};

const updateUser = (req, res) => {
  const db = getDatabase();
  const { id } = req.params;
  const { email, role, is_active } = req.body;

  db.run(
    'UPDATE users SET email = ?, role = ?, is_active = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?',
    [email, role, is_active ? 1 : 0, id],
    function(err) {
      if (err) {
        return res.status(500).json({ success: false, message: 'Error updating user' });
      }

      if (this.changes === 0) {
        return res.status(404).json({ success: false, message: 'User not found' });
      }

      createAuditLog(req.user.id, `update_user:${id}`, req.ip, req.get('user-agent'), 'success');

      res.json({
        success: true,
        message: 'User updated successfully'
      });
    }
  );
};

const deleteUser = (req, res) => {
  const db = getDatabase();
  const { id } = req.params;

  // Prevent deleting yourself
  if (parseInt(id) === req.user.id) {
    return res.status(400).json({ success: false, message: 'Cannot delete your own account' });
  }

  db.run(
    'UPDATE users SET is_active = 0, updated_at = CURRENT_TIMESTAMP WHERE id = ?',
    [id],
    function(err) {
      if (err) {
        return res.status(500).json({ success: false, message: 'Error deleting user' });
      }

      if (this.changes === 0) {
        return res.status(404).json({ success: false, message: 'User not found' });
      }

      createAuditLog(req.user.id, `delete_user:${id}`, req.ip, req.get('user-agent'), 'success');

      res.json({
        success: true,
        message: 'User deleted successfully'
      });
    }
  );
};

const unlockUser = (req, res) => {
  const db = getDatabase();
  const { id } = req.params;

  db.run(
    'UPDATE users SET is_locked = 0, failed_login_attempts = 0, updated_at = CURRENT_TIMESTAMP WHERE id = ?',
    [id],
    function(err) {
      if (err) {
        return res.status(500).json({ success: false, message: 'Error unlocking user' });
      }

      if (this.changes === 0) {
        return res.status(404).json({ success: false, message: 'User not found' });
      }

      createAuditLog(req.user.id, `unlock_user:${id}`, req.ip, req.get('user-agent'), 'success');

      res.json({
        success: true,
        message: 'User unlocked successfully'
      });
    }
  );
};

const getAuditLogs = (req, res) => {
  const db = getDatabase();
  const page = parseInt(req.query.page) || 1;
  const limit = parseInt(req.query.limit) || 50;
  const offset = (page - 1) * limit;

  db.all(
    `SELECT al.*, u.email 
     FROM audit_log al 
     LEFT JOIN users u ON al.user_id = u.id 
     ORDER BY al.created_at DESC 
     LIMIT ? OFFSET ?`,
    [limit, offset],
    (err, logs) => {
      if (err) {
        return res.status(500).json({ success: false, message: 'Database error' });
      }

      db.get('SELECT COUNT(*) as total FROM audit_log', (err, count) => {
        if (err) {
          return res.status(500).json({ success: false, message: 'Database error' });
        }

        res.json({
          success: true,
          data: {
            logs,
            pagination: {
              page,
              limit,
              total: count.total,
              totalPages: Math.ceil(count.total / limit)
            }
          }
        });
      });
    }
  );
};

const getStats = (req, res) => {
  const db = getDatabase();

  const stats = {};

  db.get('SELECT COUNT(*) as total FROM users', (err, result) => {
    stats.totalUsers = result?.total || 0;

    db.get('SELECT COUNT(*) as total FROM users WHERE is_active = 1', (err, result) => {
      stats.activeUsers = result?.total || 0;

      db.get('SELECT COUNT(*) as total FROM users WHERE is_locked = 1', (err, result) => {
        stats.lockedUsers = result?.total || 0;

        db.get('SELECT COUNT(*) as total FROM audit_log WHERE action = "login" AND status = "success" AND created_at > datetime("now", "-24 hours")', (err, result) => {
          stats.loginsLast24Hours = result?.total || 0;

          res.json({
            success: true,
            data: stats
          });
        });
      });
    });
  });
};

module.exports = {
  getUsers,
  getUserById,
  updateUser,
  deleteUser,
  unlockUser,
  getAuditLogs,
  getStats
};
