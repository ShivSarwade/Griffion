		{
			"name": "3. Two-Factor Authentication (2FA)",
			"item": [
				{
					"name": "Enable 2FA",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.secret) {",
									"        pm.environment.set('mfaSecret', jsonData.data.secret);",
									"        console.log('2FA Secret:', jsonData.data.secret);",
									"        console.log('QR Code (base64):', jsonData.data.qrCode.substring(0, 50) + '...');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/2fa/enable",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"2fa",
								"enable"
							]
						},
						"description": "Generates 2FA secret and QR code. Scan QR code with authenticator app (Google Authenticator, Authy, etc.)"
