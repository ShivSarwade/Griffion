# __PROJECT_NAME__ - Backend Configuration

# Server
PORT=__PORT__
NODE_ENV=production
FRONTEND_URL=__FRONTEND_URL__

# Database (__DB_PROVIDER__)
DATABASE_URL="__DATABASE_URL__"

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=__JWT_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Authentication
PRIMARY_IDENTIFIER=__PRIMARY_IDENTIFIER__
ENABLE_2FA=__ENABLE_2FA__
ENABLE_PASSWORD_RECOVERY=__ENABLE_PASSWORD_RECOVERY__

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=false

__EMAIL_CONFIG__
